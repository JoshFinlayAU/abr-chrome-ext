{
  "manifest_version": 3,
  "name": "ABR Lookup",
  "version": "1.0.0",
  "description": "Look up Australian businesses by name, ABN or ACN using the Australian Business Register.",
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "ABR Lookup",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "permissions": ["storage"],
  "host_permissions": ["https://abr.business.gov.au/json/*"]
}
